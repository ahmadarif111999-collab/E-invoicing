generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum FirmRole {
  FIRM_OWNER
  FIRM_PARTNER
  ACCOUNTANT
  READ_ONLY_AUDITOR
}

enum BusinessRole {
  CLIENT_OWNER
  CLIENT_STAFF
  ACCOUNTANT
  READ_ONLY_AUDITOR
}

enum InvoiceStatus {
  DRAFT
  READY_FOR_REVIEW
  VALIDATED
  SUBMISSION_PENDING
  SUBMITTED
  ACCEPTED_BY_FBR
  REJECTED_BY_FBR
  FAILED
  CANCELLED
  CREDIT_NOTE_ISSUED
  DEBIT_NOTE_ISSUED
}

enum FbrSubmissionStatus {
  MOCK_ACCEPTED
  MOCK_REJECTED
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  FAILED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  globalRole          GlobalRole           @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  firmMemberships     FirmMembership[]
  businessMemberships BusinessMembership[]
  createdInvoices     Invoice[]            @relation("CreatedInvoices")
  auditLogs           AuditLog[]
}

model Firm {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships FirmMembership[]
  businesses  Business[]
}

model FirmMembership {
  id        String   @id @default(cuid())
  userId    String
  firmId    String
  role      FirmRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([userId, firmId])
}

model Business {
  id                  String               @id @default(cuid())
  firmId              String?
  name                String
  ntn                 String?
  strn                String?
  address             String?
  invoicePrefix       String               @default("INV")
  sequenceNext        Int                  @default(1)
  productSequenceNext Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  firm        Firm?                @relation(fields: [firmId], references: [id], onDelete: SetNull)
  memberships BusinessMembership[]
  customers   Customer[]
  products    ProductService[]
  invoices    Invoice[]
  auditLogs   AuditLog[]
}

model BusinessMembership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  ntn        String?
  strn       String?
  cnic       String?
  address    String?
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model HsCode {
  id          String   @id @default(cuid())
  code        String   @unique
  displayCode String
  chapter     String?
  description String
  searchText  String
  customsDuty String?
  sourcePage  Int?
  createdAt   DateTime @default(now())

  products     ProductService[]
  invoiceItems InvoiceItem[]
}

model ProductService {
  id              String   @id @default(cuid())
  businessId      String
  itemCode        String?
  name            String
  description     String?
  defaultUnit     String   @default("PCS")
  defaultTaxRate  Decimal  @default(18) @db.Decimal(10, 2)
  defaultHsCodeId String?
  createdAt       DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultHsCode HsCode?  @relation(fields: [defaultHsCodeId], references: [id], onDelete: SetNull)

  @@unique([businessId, itemCode])
}

model Invoice {
  id               String        @id @default(cuid())
  businessId       String
  customerId       String?
  invoiceNumber    String
  status           InvoiceStatus @default(DRAFT)
  issueDate        DateTime      @default(now())
  buyerName        String
  buyerNtn         String?
  buyerStrn        String?
  buyerCnic        String?
  buyerAddress     String?
  subtotal         Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal       @default(0) @db.Decimal(18, 2)
  fbrInvoiceNumber String?
  fbrResponse      Json?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("CreatedInvoices", fields: [createdById], references: [id])
  items      InvoiceItem[]
  submissions FbrSubmission[]
  auditLogs  AuditLog[]

  @@unique([businessId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  hsCodeId    String?
  description String
  quantity    Decimal @db.Decimal(18, 2)
  unit        String  @default("PCS")
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  taxRate     Decimal @default(18) @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hsCode  HsCode? @relation(fields: [hsCodeId], references: [id], onDelete: SetNull)
}

model FbrSubmission {
  id              String              @id @default(cuid())
  invoiceId       String
  mode            String              @default("mock")
  status          FbrSubmissionStatus
  requestPayload  Json
  responsePayload Json?
  errorPayload    Json?
  referenceNumber String?
  createdAt       DateTime            @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  businessId String?
  invoiceId  String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}
